# Database (SQLite for dev; switch to Postgres URL in prod)
DATABASE_URL=sqlite+aiosqlite:///./profitly.db

# Sessions
SESSION_SECRET=change-me-to-32-random-bytes
TOKEN_ENCRYPTION_KEY=  # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Google OAuth (get from Google Cloud Console — see README "Google Cloud setup")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# ML
HF_HOME=./.cache/huggingface
TRANSFORMERS_OFFLINE=0

# Logging
LOG_LEVEL=INFO
