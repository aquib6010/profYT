# Normalize line endings: store LF in the repo, check out native on each OS.
# Silences the "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary

# Lockfiles / generated — keep diffs out of the way.
package-lock.json linguist-generated=true

# Help GitHub language stats reflect the real code, not notebooks/data.
*.ipynb linguist-documentation=true
notebooks/data/* linguist-generated=true
